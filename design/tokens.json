{
  "$description": "Three tiers. Primitives hold raw values, semantics name intent, components bind intent to a part. Nothing below the primitive tier holds a literal — every value points at the tier above it, so changing a primitive moves everything that meant it.",

  "primitive": {
    "$description": "Raw values. The only tier allowed to hold a literal.",

    "slate": {
      "50":  { "$value": { "colorSpace": "srgb", "components": [0.976, 0.980, 0.984] }, "$type": "color" },
      "100": { "$value": { "colorSpace": "srgb", "components": [0.945, 0.953, 0.965] }, "$type": "color" },
      "200": { "$value": { "colorSpace": "srgb", "components": [0.886, 0.902, 0.925] }, "$type": "color" },
      "400": { "$value": { "colorSpace": "srgb", "components": [0.580, 0.616, 0.671] }, "$type": "color" },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.278, 0.333, 0.412] }, "$type": "color" },
      "800": { "$value": { "colorSpace": "srgb", "components": [0.118, 0.161, 0.231] }, "$type": "color" },
      "900": { "$value": { "colorSpace": "srgb", "components": [0.059, 0.090, 0.165] }, "$type": "color" }
    },

    "indigo": {
      "50":  { "$value": { "colorSpace": "srgb", "components": [0.933, 0.941, 1.000] }, "$type": "color" },
      "300": { "$value": { "colorSpace": "srgb", "components": [0.647, 0.667, 0.984] }, "$type": "color" },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.388, 0.400, 0.945] }, "$type": "color" },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.310, 0.275, 0.898] }, "$type": "color" },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.263, 0.220, 0.792] }, "$type": "color" }
    },

    "amber": {
      "100": { "$value": { "colorSpace": "srgb", "components": [0.996, 0.953, 0.780] }, "$type": "color" },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.961, 0.620, 0.043] }, "$type": "color" },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.706, 0.325, 0.035] }, "$type": "color" }
    },

    "crimson": {
      "100": { "$value": { "colorSpace": "srgb", "components": [0.996, 0.886, 0.886] }, "$type": "color" },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.937, 0.267, 0.267] }, "$type": "color" },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.702, 0.149, 0.149] }, "$type": "color" }
    },

    "emerald": {
      "100": { "$value": { "colorSpace": "srgb", "components": [0.820, 0.980, 0.898] }, "$type": "color" },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.020, 0.588, 0.412] }, "$type": "color" }
    },

    "white":       { "$value": { "colorSpace": "srgb", "components": [1, 1, 1] }, "$type": "color" },
    "transparent": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0 }, "$type": "color" },

    "shadow-ink":  { "$value": { "colorSpace": "srgb", "components": [0.059, 0.090, 0.165], "alpha": 0.08 }, "$type": "color" },
    "focus-ring":  { "$value": { "colorSpace": "srgb", "components": [0.388, 0.400, 0.945], "alpha": 0.4 }, "$type": "color" },

    "size": {
      "$description": "A 4px scale. Named by step, not by intent — that is the next tier's job.",
      "0":  { "$value": { "value": 0,   "unit": "" },   "$type": "dimension" },
      "1":  { "$value": { "value": 4,   "unit": "px" }, "$type": "dimension" },
      "2":  { "$value": { "value": 8,   "unit": "px" }, "$type": "dimension" },
      "3":  { "$value": { "value": 12,  "unit": "px" }, "$type": "dimension" },
      "4":  { "$value": { "value": 16,  "unit": "px" }, "$type": "dimension" },
      "5":  { "$value": { "value": 20,  "unit": "px" }, "$type": "dimension" },
      "6":  { "$value": { "value": 24,  "unit": "px" }, "$type": "dimension" },
      "8":  { "$value": { "value": 32,  "unit": "px" }, "$type": "dimension" },
      "10": { "$value": { "value": 40,  "unit": "px" }, "$type": "dimension" },
      "12": { "$value": { "value": 48,  "unit": "px" }, "$type": "dimension" },
      "16": { "$value": { "value": 64,  "unit": "px" }, "$type": "dimension" },
      "24": { "$value": { "value": 96,  "unit": "px" }, "$type": "dimension" },
      "px": { "$value": { "value": 1,   "unit": "px" }, "$type": "dimension" }
    },

    "radius": {
      "sm":   { "$value": { "value": 4,  "unit": "px" }, "$type": "dimension" },
      "md":   { "$value": { "value": 8,  "unit": "px" }, "$type": "dimension" },
      "lg":   { "$value": { "value": 16, "unit": "px" }, "$type": "dimension" },
      "full": { "$value": "9999px" }
    },

    "font": {
      "$description": "Stacks are single strings, not lists — one CSS value each, as the converter requires.",
      "sans":    { "$value": "'Inter Tight', -apple-system, 'Helvetica Neue', Arial, sans-serif" },
      "serif":   { "$value": "'Source Serif 4', Georgia, 'Times New Roman', serif" },
      "mono":    { "$value": "'IBM Plex Mono', ui-monospace, Menlo, monospace" }
    },

    "text": {
      "xs":   { "$value": { "value": 12, "unit": "px" }, "$type": "dimension" },
      "sm":   { "$value": { "value": 14, "unit": "px" }, "$type": "dimension" },
      "base": { "$value": { "value": 16, "unit": "px" }, "$type": "dimension" },
      "lg":   { "$value": { "value": 18, "unit": "px" }, "$type": "dimension" },
      "xl":   { "$value": { "value": 22, "unit": "px" }, "$type": "dimension" },
      "2xl":  { "$value": { "value": 28, "unit": "px" }, "$type": "dimension" },
      "4xl":  { "$value": { "value": 44, "unit": "px" }, "$type": "dimension" },
      "6xl":  { "$value": { "value": 64, "unit": "px" }, "$type": "dimension" }
    },

    "weight": {
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 }
    },

    "leading": {
      "tight":   { "$value": 1.15 },
      "snug":    { "$value": 1.35 },
      "relaxed": { "$value": 1.6 }
    },

    "tracking": {
      "tight": { "$value": "-0.02em" },
      "none":  { "$value": "0" },
      "wide":  { "$value": "0.08em" }
    },

    "elevation": {
      "$description": "Single strings rather than shadow composites: one CSS value per token, which is what the converter accepts.",
      "none": { "$value": "none" },
      "low":  { "$value": "0 1px 2px rgb(15 23 42 / 0.06), 0 1px 3px rgb(15 23 42 / 0.10)" },
      "high": { "$value": "0 4px 6px rgb(15 23 42 / 0.05), 0 10px 24px rgb(15 23 42 / 0.12)" }
    },

    "motion": {
      "fast": { "$value": { "value": 120, "unit": "ms" }, "$type": "duration" },
      "base": { "$value": { "value": 200, "unit": "ms" }, "$type": "duration" },
      "ease": { "$value": "cubic-bezier(0.2, 0, 0.2, 1)" }
    }
  },

  "color": {
    "$description": "Intent, not appearance. A component asks for `surface`, never for `slate-50`.",

    "surface":        { "$value": "{primitive.white}" },
    "surface-sunken": { "$value": "{primitive.slate.50}" },
    "surface-raised": { "$value": "{primitive.white}" },

    "border":       { "$value": "{primitive.slate.200}" },
    "border-strong":{ "$value": "{primitive.slate.400}" },

    "text":          { "$value": "{primitive.slate.900}" },
    "text-muted":    { "$value": "{primitive.slate.600}" },
    "text-inverted": { "$value": "{primitive.white}" },

    "accent":         { "$value": "{primitive.indigo.600}" },
    "accent-hover":   { "$value": "{primitive.indigo.700}" },
    "accent-subtle":  { "$value": "{primitive.indigo.50}" },
    "accent-text":    { "$value": "{primitive.indigo.700}" },

    "danger":         { "$value": "{primitive.crimson.500}" },
    "danger-strong":  { "$value": "{primitive.crimson.700}" },
    "danger-subtle":  { "$value": "{primitive.crimson.100}" },

    "warning":        { "$value": "{primitive.amber.500}" },
    "warning-subtle": { "$value": "{primitive.amber.100}" },

    "success":        { "$value": "{primitive.emerald.600}" },
    "success-subtle": { "$value": "{primitive.emerald.100}" },

    "focus": { "$value": "{primitive.focus-ring}" }
  },

  "space": {
    "$description": "Named by how much room something needs, not by pixels.",
    "none":  { "$value": "{primitive.size.0}" },
    "hair":  { "$value": "{primitive.size.px}" },
    "xs":    { "$value": "{primitive.size.1}" },
    "sm":    { "$value": "{primitive.size.2}" },
    "md":    { "$value": "{primitive.size.4}" },
    "lg":    { "$value": "{primitive.size.6}" },
    "xl":    { "$value": "{primitive.size.10}" },
    "2xl":   { "$value": "{primitive.size.16}" },
    "3xl":   { "$value": "{primitive.size.24}" }
  },

  "radius": {
    "control": { "$value": "{primitive.radius.md}" },
    "card":    { "$value": "{primitive.radius.lg}" },
    "pill":    { "$value": "{primitive.radius.full}" },
    "tight":   { "$value": "{primitive.radius.sm}" }
  },

  "type": {
    "family-ui":   { "$value": "{primitive.font.sans}" },
    "family-prose":{ "$value": "{primitive.font.serif}" },
    "family-code": { "$value": "{primitive.font.mono}" },

    "size-caption": { "$value": "{primitive.text.xs}" },
    "size-label":   { "$value": "{primitive.text.sm}" },
    "size-body":    { "$value": "{primitive.text.base}" },
    "size-lead":    { "$value": "{primitive.text.lg}" },
    "size-title":   { "$value": "{primitive.text.xl}" },
    "size-heading": { "$value": "{primitive.text.2xl}" },
    "size-display": { "$value": "{primitive.text.4xl}" },
    "size-hero":    { "$value": "{primitive.text.6xl}" },

    "weight-body":    { "$value": "{primitive.weight.regular}" },
    "weight-emphasis":{ "$value": "{primitive.weight.medium}" },
    "weight-heading": { "$value": "{primitive.weight.semibold}" },
    "weight-display": { "$value": "{primitive.weight.bold}" },

    "leading-heading": { "$value": "{primitive.leading.tight}" },
    "leading-ui":      { "$value": "{primitive.leading.snug}" },
    "leading-prose":   { "$value": "{primitive.leading.relaxed}" },

    "tracking-display": { "$value": "{primitive.tracking.tight}" },
    "tracking-body":    { "$value": "{primitive.tracking.none}" },
    "tracking-eyebrow": { "$value": "{primitive.tracking.wide}" }
  },

  "elevation": {
    "flat":    { "$value": "{primitive.elevation.none}" },
    "card":    { "$value": "{primitive.elevation.low}" },
    "overlay": { "$value": "{primitive.elevation.high}" }
  },

  "motion": {
    "duration-control": { "$value": "{primitive.motion.fast}" },
    "duration-surface": { "$value": "{primitive.motion.base}" },
    "easing":           { "$value": "{primitive.motion.ease}" }
  },

  "control": {
    "$description": "The component tier. Bound to intent, never to a primitive — the point of the third hop.",
    "height-sm":     { "$value": "{primitive.size.8}" },
    "height-md":     { "$value": "{primitive.size.10}" },
    "height-lg":     { "$value": "{primitive.size.12}" },
    "padding-x":     { "$value": "{space.md}" },
    "padding-x-lg":  { "$value": "{space.lg}" },
    "gap":           { "$value": "{space.sm}" },
    "border-width":  { "$value": "{primitive.size.px}" },
    "focus-width":   { "$value": "{primitive.size.3}" }
  },

  "card": {
    "padding":    { "$value": "{space.lg}" },
    "gap":        { "$value": "{space.md}" },
    "background": { "$value": "{color.surface-raised}" },
    "border":     { "$value": "{color.border}" },
    "shadow":     { "$value": "{elevation.card}" }
  },

  "hero": {
    "padding-y":  { "$value": "{space.3xl}" },
    "gap":        { "$value": "{space.lg}" },
    "measure":    { "$value": "62ch" },
    "background": { "$value": "{color.surface-sunken}" }
  }
}
